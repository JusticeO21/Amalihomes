{
    "name": "@amalihomes/ui",
    "version": "0.0.0",
    "private": true,
    "exports": {
        "./*": "./src/*.tsx"
    },
    "scripts": {
        "test":"jest --passWithNoTests",
        "dev": "tailwindcss -i ./src/style/input.css -o ./src/style/output.css --watch",
        "lint": "eslint . --max-warnings 0",
        "generate:component": "turbo gen react-component",
        "check-types": "tsc --noEmit"
    },
    "devDependencies": {
        "@amalihomes/eslint-config": "workspace:*",
        "@amalihomes/typescript-config": "workspace:*",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.2.0",
        "@turbo/gen": "^2.4.4",
        "@types/node": "^22.13.9",
        "@types/react": "19.0.10",
        "@types/react-dom": "19.0.4",
        "eslint": "^9.22.0",
        "jest": "^29.7.0",
        "react": "^19.0.0",
        "typescript": "5.8.2"
    },
    "dependencies": {
        "@tailwindcss/cli": "^4.0.13",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cva": "npm:class-variance-authority@^0.7.1",
        "react-dom": "^19.0.0",
        "tailwind-merge": "^3.0.2",
        "tailwindcss": "^4.0.13"
    }
