{
    "name": "@amalihomes/ui",
    "version": "0.0.0",
    "private": true,
    "exports": {
        ".": "./src/index.ts",
        "./icons/*": "./src/component/icons/index.ts",
        "./*": "./src/*.{ts|tsx|css}"
    },
    "scripts": {
        "test": "jest --passWithNoTests",
        "dev": "tailwindcss -i ./src/style/input.css -o ./src/style/output.css --watch",
        "lint": "eslint . --max-warnings 0",
        "generate:component": "turbo gen react-component",
        "check-types": "tsc --noEmit"
    },
    "devDependencies": {
        "@amalihomes/eslint-config": "workspace:*",
        "@amalihomes/typescript-config": "workspace:*",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.2.0",
        "@testing-library/user-event": "^14.6.1",
        "@turbo/gen": "^2.4.4",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.13.9",
        "@types/react": "19.0.10",
        "@types/react-dom": "19.0.4",
        "eslint": "^9.22.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "react": "^19.0.0",
        "ts-jest": "^29.2.6",
        "typescript": "5.8.2"
    },
    "dependencies": {
        "@contentful/rich-text-react-renderer": "^16.0.1",
        "@contentful/rich-text-types": "^17.0.0",
        "@hookform/resolvers": "^5.0.1",
        "@tailwindcss/cli": "^4.0.13",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cva": "npm:class-variance-authority@^0.7.1",
        "lucide-react": "^0.483.0",
        "next": "^15.3.0",
        "react-dom": "^19.0.0",
        "react-hook-form": "^7.55.0",
        "tailwind-merge": "^3.0.2",
        "tailwindcss": "^4.0.13",
        "zod": "^3.24.2"
    }
}