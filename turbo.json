{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_CONTENTFUL_SPACE_ID",
    "NEXT_PUBLIC_CONTENTFUL_ACCESS_TOKEN",
    "NEXT_PUBLIC_CONTENTFUL_PREVIEW_ACCESS_TOKEN",
    "NEXT_PUBLIC_CONTENTFUL_PREVIEW_SECRET",
    "NEXT_PUBLIC_CONTENTFUL_ENVIRONMENT",
    "NEXT_PUBLIC_GTM_ID",
    "CONTENTFUL_SPACE_ID_V1",
    "CONTENTFUL_PREVIEW_ACCESS_TOKEN_V1",
    "CONTENTFUL_ACCESS_TOKEN_V1",
    "VITE_TAWK_PROPERTY_ID",
    "VITE_TAWK_WIDGET_ID"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "storybook-static/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {},
    "test:watch": {
      "cache": false,
      "persistent": true
    }
  }
}
